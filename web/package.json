{
  "name": "playground-web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun --no-install vite dev",
    "build": "bunx --bun --no-install vite build && bun run typecheck",
    "test": "bunx --bun --no-install vitest run",
    "e2e": "bunx --bun --no-install playwright test",
    "preview": "bunx --bun --no-install vite preview",
    "typecheck": "bunx --bun --no-install tsc --noEmit",
    "start": "bun server.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/context-zone": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-document-load": "^0.66.0",
    "@opentelemetry/instrumentation-fetch": "^0.221.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.65.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/sdk-trace-web": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/tanstackstart-react": "^10.70.0",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-vitals": "^6.1.0",
    "@sentry/node": "^10.70.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "5.4.0",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@types/k6": "^2.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "nitro": "^3.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "4.1.10"
  }
}
