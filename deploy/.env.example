# Copied to deploy/.env (gitignored). Compose interpolates GIT_SHA into every
# service so `vcs.ref.head.revision` is never empty.
#   git rev-parse HEAD | awk '{print "GIT_SHA="$1}' > deploy/.env
GIT_SHA=
POSTGRES_PASSWORD=playground
RABBITMQ_PASSWORD=playground
CLICKHOUSE_PASSWORD=
CATALOG_ADMIN_TOKEN=catalog-admin:tenant-acme:research-secret
FULFILLMENT_INTERNAL_TOKEN=fulfillment-internal:research-secret
